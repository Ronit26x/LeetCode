# Postgres (Supabase). The app uses the transaction pooler (port 6543, prepare: false).
# drizzle-kit migrations use the session pooler (port 5432, IPv4 compatible).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# Auth.js (GitHub OAuth). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_TRUST_HOST="true"
# Only this GitHub login may sign in.
ALLOWED_GITHUB_LOGIN="Ronit26x"

# Vercel Cron sends this as a bearer token to /api/cron/daily.
CRON_SECRET=""

# Optional 9 AM email nudge (Resend). Leave empty to disable.
RESEND_API_KEY=""
NUDGE_EMAIL_TO=""

# Local/test only. Enables a credentials provider so Playwright can sign in without GitHub.
# Refused when NODE_ENV=production.
AUTH_TEST_LOGIN=""
